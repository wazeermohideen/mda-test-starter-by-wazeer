# ─────────────────────────────────────────────────────────────────────────────
# Model-Driven App
# How to find: Open your MDA in the browser and copy the full URL including ?appid=
# ─────────────────────────────────────────────────────────────────────────────
MODEL_DRIVEN_APP_URL=https://your-org.crm.dynamics.com/main.aspx?appid=00000000-0000-0000-0000-000000000000

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft account email — used to name the saved session file
# ─────────────────────────────────────────────────────────────────────────────
MS_AUTH_EMAIL=you@yourorg.com

# ─────────────────────────────────────────────────────────────────────────────
# Power Apps base URL (only needed if you use npm run auth:headful for Canvas)
# ─────────────────────────────────────────────────────────────────────────────
# POWER_APPS_BASE_URL=https://make.powerapps.com

# ─────────────────────────────────────────────────────────────────────────────
# Test runner
# ─────────────────────────────────────────────────────────────────────────────
HEADLESS=false
WORKERS=1

# ─────────────────────────────────────────────────────────────────────────────
# Faker domain — controls what kind of test data is generated
# Options: generic | airline | healthcare | government
# ─────────────────────────────────────────────────────────────────────────────
FAKER_DOMAIN=generic

# ─────────────────────────────────────────────────────────────────────────────
# Dataverse / Graph API credentials (only needed for API seeding — not for UI tests)
# Create an App Registration in Azure AD with Dataverse permissions
# ─────────────────────────────────────────────────────────────────────────────
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# SHAREPOINT_SITE_ID=your-sharepoint-site-id
